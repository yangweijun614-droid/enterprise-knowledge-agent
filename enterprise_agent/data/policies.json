[
  {
    "policy_id": "TRAVEL",
    "title": "国内差旅与住宿制度",
    "version": "2024",
    "effective_from": "2024-01-01",
    "roles": [
      "staff",
      "finance"
    ],
    "clauses": [
      {
        "id": "A1",
        "heading": "一线城市住宿标准",
        "text": "北京、上海、广州、深圳的国内出差住宿上限为每人每晚500元，凭合规发票按实际发生金额报销。",
        "topics": [
          "酒店住宿",
          "住宿标准",
          "宾馆限额",
          "房费上限",
          "一线城市住宿"
        ]
      },
      {
        "id": "A2",
        "heading": "其他城市住宿标准",
        "text": "其他城市的国内出差住宿上限为每人每晚400元，凭合规发票按实际发生金额报销。",
        "topics": [
          "其他城市",
          "非一线城市",
          "二线城市住宿"
        ]
      },
      {
        "id": "A3",
        "heading": "差旅餐补",
        "text": "国内出差期间按自然日发放每人每天100元餐补。会议或接待方已统一供餐的当天不重复领取。",
        "topics": [
          "餐补",
          "伙食补助",
          "出差餐费",
          "出差吃饭",
          "餐费补助"
        ]
      },
      {
        "id": "A4",
        "heading": "交通标准",
        "text": "普通员工国内出差可乘高铁二等座或飞机经济舱，超出标准的部分由本人承担，提前获书面批准的例外除外。",
        "topics": [
          "高铁",
          "火车座席",
          "经济舱",
          "机票舱位",
          "交通标准"
        ]
      },
      {
        "id": "A5",
        "heading": "同城交通",
        "text": "因公同城交通可凭电子发票和行程明细申请报销，通勤费用除外。",
        "topics": [
          "同城交通",
          "打车报销",
          "网约车",
          "打车票",
          "通勤费用"
        ]
      }
    ]
  },
