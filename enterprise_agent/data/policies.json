  {
    "policy_id": "EXPENSE",
    "title": "费用报销管理办法",
    "version": "2025",
    "effective_from": "2025-01-01",
    "roles": [
      "staff",
      "finance"
    ],
    "clauses": [
      {
        "id": "B1",
        "heading": "报销提交期限",
        "text": "费用发生后应在30个自然日内提交报销申请。逾期需上传说明并经部门负责人批准。",
        "topics": [
          "提交期限",
          "报销时限",
          "多久提交",
          "逾期",
          "过期报销",
          "报销截止"
        ]
      },
      {
        "id": "B2",
        "heading": "报销所需凭证",
        "text": "提交报销时需上传合规电子发票或纸质发票扫描件，并填写费用事由。差旅报销还需提供行程证明。",
        "topics": [
          "所需凭证",
          "需要什么材料",
          "发票",
          "报销材料",
          "行程证明"
        ]
      },
      {
        "id": "B3",
        "heading": "无发票处理",
        "text": "无法取得合规发票时，应先联系财务并提交可核验的付款凭证及说明。财务复核后决定是否受理。",
        "topics": [
          "没有发票",
          "无发票",
          "发票丢了",
          "没有票据"
        ]
      },
      {
        "id": "B4",
        "heading": "报销审批流程",
        "text": "普通费用报销依次经过部门负责人审批和财务复核。财务复核通过且打款完成后，单据状态更新为已付款。",
        "topics": [
          "审批流程",
          "谁来审批",
          "报销流程",
          "复核步骤",
          "审批有哪些环节"
        ]
      },
      {
        "id": "B5",
        "heading": "报销款支付",
        "text": "财务复核通过后原则上在5个工作日内安排支付，节假日顺延。",
        "topics": [
          "多久打款",
          "几天付款",
          "支付时间",
          "什么时候到账",
          "到账时间"
        ]
      }
    ]
  },
  {
    "policy_id": "AUDIT",
    "title": "财务内部抽样复核指引",
    "version": "2025",
    "effective_from": "2025-01-01",
    "roles": [
      "finance"
    ],
    "clauses": [
      {
        "id": "C1",
        "heading": "内审抽样比例",
        "text": "月度费用内审以当月已付款单据为抽样总体，基准抽样比例为10%，高风险单据执行额外复核。",
        "topics": [
          "内审抽样",
          "抽样比例",
          "审计抽样",
          "内审抽几成"
        ]
      },
      {
        "id": "C2",
        "heading": "内部复核时效",
        "text": "财务收到抽样复核任务后应于3个工作日内完成复核并记录原因。",
        "topics": [
          "抽样复核时效",
          "内审复核期限",
          "内审工作日"
        ]
      }
    ]
  }
]
